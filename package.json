  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.3",
    "babel-preset-expo": "~12.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=20"
